'use client';

import { useMemo, useState } from 'react';
import { getSupabase } from '../lib/supabase';

type Group = { id: number; name: string };
type Account = { id: number; group_id: number; name: string; account_type: string; opening_date: string };
type Props = { groups: Group[]; accounts: Account[]; onSaved: () => void };

const today = () => { const d = new Date(); const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000); return local.toISOString().slice(0, 10); };

export default function EntryForm({ groups, accounts, onSaved }: Props) {
  const [open, setOpen] = useState(false);
  const [kind, setKind] = useState<'income' | 'expense'>('income');
  const [incomeChannel, setIncomeChannel] = useState<'cash' | 'pos' | 'other'>('cash');
  const [groupId, setGroupId] = useState('');
  const [accountId, setAccountId] = useState('');
  const [date, setDate] = useState(today);
  const [amount, setAmount] = useState('');
  const [description, setDescription] = useState('');
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState('');
  const available = useMemo(() => accounts.filter(a => String(a.group_id) === groupId && (kind !== 'income' || incomeChannel === 'other' || (incomeChannel === 'cash' ? a.account_type === 'cash' : a.account_type === 'bank'))), [accounts, groupId, kind, incomeChannel]);

  async function save(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (busy) return;
    setMessage('');
    const db = getSupabase();
    if (!db) { setMessage('Veritabanı bağlantısı bulunamadı.'); return; }
    const numeric = Number(amount.replace(',', '.'));
    const account = available.find(a => String(a.id) === accountId);
    if (!groupId || !account || !date || !description.trim() || description.trim().length > 500 || !Number.isFinite(numeric) || numeric <= 0 || numeric > 999999999999 || Math.abs(Math.round(numeric * 100) - numeric * 100) > 0.000001) {
      setMessage('Grup, hesap, tarih, açıklama ve en fazla 2 ondalıklı pozitif tutar girin.'); return;
    }
    if (kind === 'income' && incomeChannel === 'cash' && account.account_type !== 'cash') { setMessage('Nakit gelir için kasa hesabı seçin.'); return; }
    if (kind === 'income' && incomeChannel === 'pos' && account.account_type !== 'bank') { setMessage('POS geliri için banka hesabı seçin.'); return; }
    if (date < account.opening_date) { setMessage('İşlem tarihi hesabın açılış tarihinden önce olamaz.'); return; }
    if (!window.confirm(`${kind === 'income' ? `GELİR (${incomeChannel === 'cash' ? 'NAKİT' : incomeChannel === 'pos' ? 'POS' : 'DİĞER'})` : 'GİDER'} kaydı oluşturulsun mu?\n${numeric.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' })}\n${description.trim()}`)) return;
    setBusy(true);
    const requestId = crypto.randomUUID();
    try {
      const { error } = await db.rpc('finance_record_entry', {
        p_group_id: Number(groupId), p_account_id: Number(accountId), p_document_type: kind,
        p_description: description.trim(), p_amount: numeric, p_date: date, p_request_id: requestId,
        p_income_channel: kind === 'income' ? incomeChannel : null
      });
      if (error) throw error;
      setAmount(''); setDescription(''); setOpen(false); setMessage('Kayıt başarıyla oluşturuldu.'); onSaved();
    } catch (e) {
      setMessage('Kayıt oluşturulamadı: ' + (e instanceof Error ? e.message : 'Bilinmeyen hata'));
    } finally { setBusy(false); }
  }

  return <section className="panel" style={{ marginBottom: 18 }}>
    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12, flexWrap: 'wrap' }}>
      <div><h2>Gelir / Gider Kaydı</h2><p className="muted">Kasa veya banka hesabına bağlı gerçekleşen işlemleri kaydet.</p></div>
      <button type="button" onClick={() => { setOpen(v => !v); setMessage(''); }}>{open ? 'Formu Kapat' : '+ Yeni İşlem'}</button>
    </div>
    {message && <p role="status" className="muted">{message}</p>}
    {open && <form onSubmit={save} style={{ display: 'grid', gap: 14, marginTop: 18, maxWidth: 540 }}>
      <label>İşlem türü
        <select required value={kind} onChange={e => setKind(e.target.value as 'income' | 'expense')}>
          <option value="income">Gelir (hesaba para girişi)</option><option value="expense">Gider (hesaptan para çıkışı)</option>
        </select>
      </label>
      {kind === 'income' && <label>Gelir türü
        <select required value={incomeChannel} onChange={e => { setIncomeChannel(e.target.value as 'cash' | 'pos' | 'other'); setAccountId(''); }}>
          <option value="cash">Nakit</option>
          <option value="pos">POS</option>
          <option value="other">Diğer (havale, EFT vb.)</option>
        </select>
      </label>}
      <label>Finans grubu
        <select required value={groupId} onChange={e => { setGroupId(e.target.value); setAccountId(''); }}>
          <option value="">Grup seçin</option>{groups.map(g => <option key={g.id} value={g.id}>{g.name}</option>)}
        </select>
      </label>
      <label>Kasa / Banka / Kart hesabı
        <select required value={accountId} onChange={e => setAccountId(e.target.value)}>
          <option value="">Hesap seçin</option>{available.map(a => <option key={a.id} value={a.id}>{a.name} ({a.account_type})</option>)}
        </select>
      </label>
      {groupId && available.length === 0 && <p className="error">Seçilen gelir türüne uygun hesap yok. Önce ilgili kasa veya banka hesabı oluşturulmalı.</p>}
      <label>İşlem tarihi<input required type="date" value={date} onChange={e => setDate(e.target.value)} /></label>
      <label>Tutar (TL)<input required type="text" inputMode="decimal" placeholder="Ör. 1250,50" value={amount} onChange={e => setAmount(e.target.value)} /></label>
      <label>Açıklama<input required maxLength={500} value={description} placeholder="Ör. Günlük satış / elektrik faturası" onChange={e => setDescription(e.target.value)} /></label>
      <button type="submit" disabled={busy || !available.length}>{busy ? 'Kaydediliyor…' : 'İşlemi Kaydet'}</button>
      <small>Gelir türü ayrı kaydedilir; POS banka hesabına, nakit kasa hesabına işlenir. Bu kayıt hem gelir/gider belgesi hem hesap hareketi oluşturur. Henüz düzenleme veya silme yoktur.</small>
    </form>}
  </section>;
}
